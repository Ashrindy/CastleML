{
    "version": 3,
    "configurePresets": [
        {
            "name": "mingw-linux-release",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_SYSTEM_PROCESSOR": "x86",
                "CMAKE_C_COMPILER": "i686-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "i686-w64-mingw32-g++",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        },
        {
            "name": "mingw-linux-debug",
            "inherits": "mingw-linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mingw-windows-release",
            "inherits": "mingw-linux-release",
            "generator": "MinGW Makefiles",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Windows"
            }
        },
        {
            "name": "mingw-windows-debug",
            "inherits": "mingw-windows-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}
